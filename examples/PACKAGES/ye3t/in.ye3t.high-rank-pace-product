# Deterministic high-rank reference for stock ML-PACE product execution.

variable model index models/ta_l8_h16/model.yace
variable dump_path index dump.ye3t.high-rank-pace-product

units metal
atom_style atomic
boundary p p p
atom_modify map yes sort 0 0.0
newton on

variable a equal 3.300
lattice bcc ${a}
region cell block 0 3 0 3 0 3 units lattice
create_box 1 cell
create_atoms 1 box
mass 1 180.94788
reset_atoms id sort yes
displace_atoms all random 0.18 0.18 0.18 918273 units box

neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes

pair_style pace product
pair_coeff * * ${model} Ta

compute atom_energy all pe/atom
compute atom_stress all stress/atom NULL pair
compute pair_pressure all pressure NULL pair
thermo 1
thermo_style custom step atoms vol pe c_pair_pressure[1] &
  c_pair_pressure[2] c_pair_pressure[3] c_pair_pressure[4] &
  c_pair_pressure[5] c_pair_pressure[6]
thermo_modify format float %.17g
run 0 post no

write_dump all custom ${dump_path} id type x y z c_atom_energy &
  c_atom_stress[1] c_atom_stress[2] c_atom_stress[3] &
  c_atom_stress[4] c_atom_stress[5] c_atom_stress[6] fx fy fz &
  modify sort id format float %.17g
