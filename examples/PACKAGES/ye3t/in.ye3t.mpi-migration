# Atom-domain-crossing check for PairYE3T ghost and reverse-force handling.

variable mpi_ranks index 4
variable model index models/ta_l8_compact/model.yace
variable plan index models/ta_l8_compact/manifest.json
variable policy index auto
variable dump_path index dump.ye3t.mpi-migration

units metal
atom_style atomic
boundary p p p
atom_modify map yes sort 0 0.0
newton on
processors ${mpi_ranks} 1 1

variable a equal 3.300
lattice bcc ${a}
region cell block 0 3 0 3 0 3 units lattice
create_box 1 cell
create_atoms 1 box
mass 1 180.94788
reset_atoms id sort yes

region mover_region sphere 4.95 1.65 1.65 0.10 units box
group mover region mover_region
displace_atoms mover move -0.10 0.0 0.0 units box

neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes

pair_style ye3t plan ${plan} block_policy ${policy} chunksize 256
pair_coeff * * ${model} Ta

compute atom_energy all pe/atom
compute atom_stress all stress/atom NULL pair
compute pair_pressure all pressure NULL pair

thermo 1
thermo_style custom step atoms vol pe c_pair_pressure[1] &
  c_pair_pressure[2] c_pair_pressure[3] c_pair_pressure[4] &
  c_pair_pressure[5] c_pair_pressure[6]
thermo_modify format float %.17g

run 0 post yes
timestep 0.001
fix migrate mover move linear 200.0 0.0 0.0 units box
run 1 post yes

write_dump all custom ${dump_path} id type proc x y z c_atom_energy &
  c_atom_stress[1] c_atom_stress[2] c_atom_stress[3] &
  c_atom_stress[4] c_atom_stress[5] c_atom_stress[6] fx fy fz &
  modify sort id format float %.17g
