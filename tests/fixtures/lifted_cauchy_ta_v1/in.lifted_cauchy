# One-rank LAMMPS parity, numerical differentiation, and fixed-position replay
# for the deterministic lifted-Cauchy validation fixture.

variable load_plugin index 0
variable plugin_path index none
if "${load_plugin} == 1" then "plugin load ${plugin_path}"

variable model index model.ye3t.json
variable source_realization index factorized
variable model_family index lifted_cauchy
variable block_policy index direct
variable element index Ta
variable snapshot_path index lifted.snapshot.dump
variable replay_path index lifted.replay.dump
variable force_delta index 1.0e-5
variable virial_delta index 1.0e-6
variable sort_interval index 1

units metal
atom_style atomic
boundary p p p
atom_modify map yes sort ${sort_interval} 0.0
newton on

region cell block 0 20 0 20 0 20 units box
create_box 1 cell

# This is the reference geometry translated and wrapped into the periodic box.
# The box length exceeds twice the 5.2-A cutoff, so there is one image per pair.
create_atoms 1 single 0.3 0.8 0.6 units box
create_atoms 1 single 2.1 0.9 0.4 units box
create_atoms 1 single 19.9 2.8 0.9 units box
create_atoms 1 single 0.5 0.1 2.7 units box
mass 1 180.94788

neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes

pair_style ye3t model_family ${model_family} &
  source_realization ${source_realization} block_policy ${block_policy} chunksize 2
pair_coeff * * ${model} ${element}

compute atom_energy all pe/atom
compute atom_stress all stress/atom NULL pair
compute pair_pressure all pressure NULL pair
compute force_sum all reduce sum fx fy fz

fix numerical_force all numdiff 1 ${force_delta}
fix numerical_virial all numdiff/virial 1 ${virial_delta}

variable dfx atom f_numerical_force[1]-fx
variable dfy atom f_numerical_force[2]-fy
variable dfz atom f_numerical_force[3]-fz
variable dfmag atom sqrt(v_dfx*v_dfx+v_dfy*v_dfy+v_dfz*v_dfz)
compute force_error all reduce max v_dfmag

# numdiff/virial: xx yy zz yz xz xy; pressure: xx yy zz xy xz yz.
variable dv1 equal f_numerical_virial[1]-c_pair_pressure[1]
variable dv2 equal f_numerical_virial[2]-c_pair_pressure[2]
variable dv3 equal f_numerical_virial[3]-c_pair_pressure[3]
variable dv4 equal f_numerical_virial[4]-c_pair_pressure[6]
variable dv5 equal f_numerical_virial[5]-c_pair_pressure[5]
variable dv6 equal f_numerical_virial[6]-c_pair_pressure[4]
variable virial_error_bar equal sqrt(v_dv1*v_dv1+v_dv2*v_dv2+ &
  v_dv3*v_dv3+v_dv4*v_dv4+v_dv5*v_dv5+v_dv6*v_dv6)
variable virial_error_eV equal v_virial_error_bar*vol/1.6021765e6

variable virial_xx equal c_pair_pressure[1]*vol/1.6021765e6
variable virial_yy equal c_pair_pressure[2]*vol/1.6021765e6
variable virial_zz equal c_pair_pressure[3]*vol/1.6021765e6
variable virial_xy equal c_pair_pressure[4]*vol/1.6021765e6
variable virial_xz equal c_pair_pressure[5]*vol/1.6021765e6
variable virial_yz equal c_pair_pressure[6]*vol/1.6021765e6

thermo 1
thermo_style custom step atoms vol pe c_pair_pressure[1] &
  c_pair_pressure[2] c_pair_pressure[3] c_pair_pressure[4] &
  c_pair_pressure[5] c_pair_pressure[6] c_force_sum[1] &
  c_force_sum[2] c_force_sum[3]
thermo_modify format float %.17g

dump snapshot all custom 1 ${snapshot_path} id type x y z c_atom_energy &
  c_atom_stress[1] c_atom_stress[2] c_atom_stress[3] &
  c_atom_stress[4] c_atom_stress[5] c_atom_stress[6] fx fy fz
dump_modify snapshot sort id format float %.17g
run 0 post no

print "YE3T_LIFTED_PE=$(pe:%.17g)"
print "YE3T_LIFTED_NUMDIFF_FORCE_MAX_ABS=$(c_force_error:%.17g)"
print "YE3T_LIFTED_NUMDIFF_VIRIAL_L2_BAR=$(v_virial_error_bar:%.17g)"
print "YE3T_LIFTED_NUMDIFF_VIRIAL_L2_EV=$(v_virial_error_eV:%.17g)"
print "YE3T_LIFTED_VIRIAL_XX=$(v_virial_xx:%.17g)"
print "YE3T_LIFTED_VIRIAL_YY=$(v_virial_yy:%.17g)"
print "YE3T_LIFTED_VIRIAL_ZZ=$(v_virial_zz:%.17g)"
print "YE3T_LIFTED_VIRIAL_XY=$(v_virial_xy:%.17g)"
print "YE3T_LIFTED_VIRIAL_XZ=$(v_virial_xz:%.17g)"
print "YE3T_LIFTED_VIRIAL_YZ=$(v_virial_yz:%.17g)"

undump snapshot
unfix numerical_force
unfix numerical_virial

dump replay all custom 1 ${replay_path} id type x y z c_atom_energy &
  c_atom_stress[1] c_atom_stress[2] c_atom_stress[3] &
  c_atom_stress[4] c_atom_stress[5] c_atom_stress[6] fx fy fz
dump_modify replay sort id format float %.17g
run 5 post no
undump replay
