# Offset-only one-atom check for the deterministic lifted-Cauchy fixture.

variable model index model.ye3t.json
variable source_realization index factorized
variable element index Ta
variable dump_path index lifted.isolated.dump

units metal
atom_style atomic
boundary p p p
atom_modify map yes sort 0 0.0
newton on

region cell block 0 20 0 20 0 20 units box
create_box 1 cell
create_atoms 1 single 10 10 10 units box
mass 1 180.94788

neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes

pair_style ye3t model_family lifted_cauchy &
  source_realization ${source_realization} chunksize 2
pair_coeff * * ${model} ${element}

compute atom_energy all pe/atom
compute atom_stress all stress/atom NULL pair
dump result all custom 1 ${dump_path} id type c_atom_energy &
  c_atom_stress[1] c_atom_stress[2] c_atom_stress[3] &
  c_atom_stress[4] c_atom_stress[5] c_atom_stress[6] fx fy fz
dump_modify result sort id format float %.17g

thermo 1
thermo_style custom step pe
thermo_modify format float %.17g
run 0 post no
print "YE3T_LIFTED_ISOLATED_PE=$(pe:%.17g)"
undump result
