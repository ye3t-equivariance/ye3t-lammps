# Two-element source/head/remapping check for the deterministic lifted fixture.

variable load_plugin index 0
variable plugin_path index none
if "${load_plugin} == 1" then "plugin load ${plugin_path}"

variable model index model.ye3t.json
variable source_realization index factorized
variable mpi_ranks index 1
variable ta_type index 1
variable w_type index 2
variable element1 index Ta
variable element2 index W
variable dump_path index lifted_ta_w.dump

units metal
atom_style atomic
boundary p p p
atom_modify map yes sort 1 0.0
newton on
processors ${mpi_ranks} 1 1

region cell block 0 12 0 12 0 12 units box
create_box 2 cell
create_atoms ${ta_type} single 5.00 5.00 5.00 units box
create_atoms ${w_type} single 5.28 7.52 5.28 units box
create_atoms ${ta_type} single 7.24 5.28 4.58 units box
create_atoms ${w_type} single 6.82 4.16 7.10 units box
create_atoms ${ta_type} single 4.20 6.10 7.70 units box
create_atoms ${w_type} single 8.60 7.80 6.10 units box
mass ${ta_type} 180.94788
mass ${w_type} 183.84

neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes

pair_style ye3t model_family lifted_cauchy &
  source_realization ${source_realization} chunksize 3
pair_coeff * * ${model} ${element1} ${element2}

compute atom_energy all pe/atom
compute atom_stress all stress/atom NULL pair
compute pair_pressure all pressure NULL pair
compute force_sum all reduce sum fx fy fz
variable virial_xx equal c_pair_pressure[1]*vol/1.6021765e6
variable virial_yy equal c_pair_pressure[2]*vol/1.6021765e6
variable virial_zz equal c_pair_pressure[3]*vol/1.6021765e6
variable virial_xy equal c_pair_pressure[4]*vol/1.6021765e6
variable virial_xz equal c_pair_pressure[5]*vol/1.6021765e6
variable virial_yz equal c_pair_pressure[6]*vol/1.6021765e6

thermo 1
thermo_style custom step atoms vol pe c_pair_pressure[1] &
  c_pair_pressure[2] c_pair_pressure[3] c_pair_pressure[4] &
  c_pair_pressure[5] c_pair_pressure[6] c_force_sum[1] &
  c_force_sum[2] c_force_sum[3]
thermo_modify format float %.17g

dump snapshot all custom 1 ${dump_path} id type x y z c_atom_energy &
  c_atom_stress[1] c_atom_stress[2] c_atom_stress[3] &
  c_atom_stress[4] c_atom_stress[5] c_atom_stress[6] fx fy fz
dump_modify snapshot sort id format float %.17g
run 0 post no

print "YE3T_LIFTED_MULTI_PE=$(pe:%.17g)"
print "YE3T_LIFTED_MULTI_VIRIAL_XX=$(v_virial_xx:%.17g)"
print "YE3T_LIFTED_MULTI_VIRIAL_YY=$(v_virial_yy:%.17g)"
print "YE3T_LIFTED_MULTI_VIRIAL_ZZ=$(v_virial_zz:%.17g)"
print "YE3T_LIFTED_MULTI_VIRIAL_XY=$(v_virial_xy:%.17g)"
print "YE3T_LIFTED_MULTI_VIRIAL_XZ=$(v_virial_xz:%.17g)"
print "YE3T_LIFTED_MULTI_VIRIAL_YZ=$(v_virial_yz:%.17g)"
