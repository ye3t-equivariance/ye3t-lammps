# Static BCC Ta probe for a fitted ordinary-PACE plus lifted-YE3T model.

variable plugin_path index none
variable plugin_setup index plugin.dynamic.inc
variable ordinary_model index ordinary.yace
variable lifted_model index model.ye3t.json
variable source_realization index factorized
variable pair_setup index none
variable dump_path index overlay.snapshot.dump

include ${plugin_setup}

units metal
atom_style atomic
boundary p p p

lattice bcc 3.3
region cell block 0 3 0 3 0 3 units lattice
create_box 1 cell
create_atoms 1 box
mass 1 180.94788
reset_atoms id sort yes

group displaced id 1
displace_atoms displaced move 0.07 -0.04 0.03 units box

neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes
newton on

include ${pair_setup}

compute atom_energy all pe/atom
compute atom_stress all stress/atom NULL pair
dump result all custom 1 ${dump_path} id type x y z &
  c_atom_energy c_atom_stress[1] c_atom_stress[2] c_atom_stress[3] &
  c_atom_stress[4] c_atom_stress[5] c_atom_stress[6] fx fy fz
dump_modify result sort id format float %.17g

thermo 1
thermo_style custom step atoms pe press pxx pyy pzz pxy pxz pyz
run 0
print "YE3T_OVERLAY_PE $(pe:%.17g)"
print "YE3T_OVERLAY_PRESS $(press:%.17g)"
